# Copy to .env and fill in. Never commit .env.
# Get the Neon connection details from the Neon console (project "dams").

# JDBC URL, e.g. jdbc:postgresql://<host>/dams?sslmode=require
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Any string >= 32 chars. Use a real secret outside local dev.
JWT_SECRET=dams-local-dev-secret-do-not-use-in-production-min-32-chars

# Frontend origin — used to build accept-invite links and to allow CORS
APP_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Where the browser bundle sends API calls (baked into the frontend image at build time)
VITE_API_URL=http://localhost:8080

# Attachment storage: "local" (default, bytes on disk) or "r2" (Cloudflare R2, S3-compatible).
# Leave as "local" unless the four R2_* values below are filled in.
DAMS_STORAGE_PROVIDER=local
# From Cloudflare: R2 -> <bucket> -> Manage R2 API Tokens -> "S3 API" credentials.
R2_ENDPOINT=            # https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
