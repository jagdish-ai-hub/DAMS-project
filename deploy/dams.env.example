# Copy to /opt/dams/.env on the VPS and fill in. chmod 600. Never commit the filled copy.
# Used two ways by compose.prod.yml: variable substitution (IMAGE_PREFIX) and env_file (the rest,
# passed into the backend container).

# --- which images to pull (owner/repo lowercased, as GHCR stores them) ---
IMAGE_PREFIX=ghcr.io/your-github-username/dams-project

# --- database: Neon (production branch/role — not the same creds as local dev) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>.neon.tech/dams?sslmode=require
SPRING_DATASOURCE_USERNAME=dams_owner
SPRING_DATASOURCE_PASSWORD=

# --- auth: generate a FRESH 32+ char secret for prod (openssl rand -base64 48) ---
JWT_SECRET=

# --- public origin: used for invite links and the CORS allowlist ---
APP_BASE_URL=https://dams.example.com
CORS_ALLOWED_ORIGINS=https://dams.example.com

# --- attachment storage: Cloudflare R2 ---
DAMS_STORAGE_PROVIDER=r2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dams
